# Copy to backend/.env for local overrides. Nothing here is required for local
# development: without DATABASE_URL an embedded PostgreSQL is used (data in backend/data/).

# NODE_ENV=development
# PORT=3001

# Production database (required when NODE_ENV=production)
# DATABASE_URL=postgres://user:password@host:5432/nova
# DATABASE_SSL=true            # use SSL (set automatically if the URL contains sslmode=require)
# DATABASE_SSL_VERIFY=true     # also verify the server certificate
# DATABASE_POOL_SIZE=10

# Login tokens. Required in production, at least 32 random characters.
# JWT_SECRET=
# JWT_EXPIRES_IN=12h

# Default time zone for new companies and for scheduling calculations
# APP_TIMEZONE=Europe/Berlin

# Only needed if the frontend runs on a different domain than the API
# CORS_ORIGINS=https://app.example.com

# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
# TRUST_PROXY=1

# Links in e-mails (password reset, e-mail confirmation)
# APP_URL=https://nova.example.de
# Outgoing e-mail; without SMTP_HOST the mails are only written to the log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=NOVA <no-reply@example.de>
# New registrations must confirm their e-mail (default: on when SMTP_HOST is set)
# REQUIRE_EMAIL_VERIFICATION=true
# Passphrase for encrypted backups (scripts/backup.js), keep a copy outside the server
# BACKUP_KEY=
